rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // 1. User Profiles: Prevent privilege escalation
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Users can update non-role fields only on their own document; cannot assign role or admin status
      allow create, update: if isAuthenticated() && request.auth.uid == userId 
        && !('role' in request.resource.data) 
        && !('admin' in request.resource.data);
      allow delete: if isAdmin();
    }

    // 2. Administrative collections: Strict admin access only
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    // 3. Public Collections: Public read, Admin-only write
    match /notices/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faculty/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /downloads/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /staff/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /organizations/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /agencies/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /activities/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /achievements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /programmes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Resources and Media
    match /media/{mediaId} {
      allow read: if resource.data.isPublishedToGallery == true || isAdmin();
      allow write: if isAdmin();
    }
    match /resources/{resourceId} {
      allow read: if resource.data.isPublic == true || isAdmin();
      allow write: if isAdmin();
    }

    // 5. Alumni Collection: Prevent pending data leaks & enforce schema
    match /alumni/{docId} {
      // Visitors can only read approved profiles; admins can read everything
      allow read: if resource.data.status == 'approved' || isAdmin();

      // Anyone can submit a pending profile, but must match strict field schema
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'fullName', 'batchYear', 'currentRole', 'organization',
          'sector', 'location', 'higherStudies', 'quote',
          'photoUrl', 'linkedinUrl', 'status', 'createdAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 1
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.batchYear is string
        && request.resource.data.batchYear.size() >= 4
        && request.resource.data.batchYear.size() <= 20
        && request.resource.data.currentRole is string
        && request.resource.data.currentRole.size() <= 120
        && request.resource.data.organization is string
        && request.resource.data.organization.size() <= 150
        && request.resource.data.sector is string
        && request.resource.data.sector.size() <= 80
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 100
        && request.resource.data.higherStudies is string
        && request.resource.data.higherStudies.size() <= 200
        && request.resource.data.quote is string
        && request.resource.data.quote.size() <= 600
        && request.resource.data.linkedinUrl is string
        && request.resource.data.linkedinUrl.size() <= 250
        && (request.resource.data.linkedinUrl.size() == 0 || request.resource.data.linkedinUrl.matches('^https://(www\\.)?linkedin\\.com/.*'))
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 500
        && (request.resource.data.photoUrl.size() == 0 || request.resource.data.photoUrl.matches('^https://res\\.cloudinary\\.com/.*'));

      // Only admins can approve, edit, or delete alumni profiles
      allow update, delete: if isAdmin();
    }

    // 6. Alumni Private Contact Records: Admin read/manage only, public create with strict validation
    match /alumni_private/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['email', 'fullName', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 150
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() <= 100;
    }
  }
}