rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // 1. User Profiles: Prevent privilege escalation
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Users can update non-role fields only on their own document; cannot assign role or admin status
      allow create, update: if isAuthenticated() && request.auth.uid == userId 
        && !('role' in request.resource.data) 
        && !('admin' in request.resource.data);
      allow delete: if isAdmin();
    }

    // 2. Administrative collections: Strict admin access only
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    // 3. Public Collections: Public read, Admin-only write
    match /notices/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faculty/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /downloads/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /staff/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /organizations/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /agencies/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /activities/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /achievements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /programmes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Resources and Media
    match /media/{mediaId} {
      allow read: if resource.data.isPublishedToGallery == true || isAdmin();
      allow write: if isAdmin();
    }
    match /resources/{resourceId} {
      allow read: if resource.data.isPublic == true || isAdmin();
      allow write: if isAdmin();
    }

    // 5. Alumni Collection: Prevent pending data leaks & enforce schema
    match /alumni/{docId} {
      // Visitors can only read approved profiles; admins can read everything
      allow read: if resource.data.status == 'approved' || isAdmin();

      // Anyone can submit a pending profile, but must match strict field schema
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'fullName', 'batchYear', 'currentRole', 'organization',
          'sector', 'location', 'higherStudies', 'quote',
          'photoUrl', 'linkedinUrl', 'email', 'status', 'createdAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.batchYear is string
        && request.resource.data.batchYear.size() <= 20;

      // Only admins can approve, edit, or delete alumni profiles
      allow update, delete: if isAdmin();
    }
  }
}